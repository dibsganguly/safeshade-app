<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The app window itself. Compose owns everything inside it. -->
    <style name="Theme.SafeShade" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_bone</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        The launch theme, handed to core-splashscreen. It exists so the cold
        start shows the emblem on the brand ground instead of a white flash,
        and is swapped for Theme.SafeShade in onCreate.
    -->
    <style name="Theme.SafeShade.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_bone</item>
        <!--
            No windowSplashScreenAnimatedIcon. The OS drew the emblem here,
            large and centred, and then IntroScreen drew the same asset again
            a moment later - so the user watched one emblem vanish and a
            second appear before the animation had started. The intro owns the
            whole performance now; this theme supplies only the ground it
            begins on, so there is exactly one emblem and it never restarts.
        -->
        <item name="postSplashScreenTheme">@style/Theme.SafeShade</item>
    </style>
</resources>
