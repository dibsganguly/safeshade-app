<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy Bluetooth permissions for devices below Android 12 (API 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
        BLE scanning here only ever filters by our own SERVICE_UUID to find
        a SafeShade device - scan results are never used to derive the
        phone's physical location. neverForLocation lets the OS know that,
        so this permission does not implicitly require location access to
        be usable (see BleManager.startScanning()).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Used for actual GPS-based weather sync (MainActivity.fetchAndSendWeather), unrelated to BLE -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Geofencing safe-zone alerts need to fire while the app is backgrounded -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Real auto-call-emergency on confirmed fall (user-confirmed, never silent-dialed) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- SMS fallback: emergency alerts, and device-independent Guardian<->device messaging (SmsReceiver/EmergencyActions.sendSmsText) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Geofence enter/exit and fall-alert notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeShade">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SafeShade">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".GeofenceBroadcastReceiver"
            android:exported="false" />

        <!--
            SMS_RECEIVED is a protected system broadcast, so exported="true"
            here only lets the OS itself deliver it (android:permission
            requires the sender to hold BROADCAST_SMS, which only the
            platform does) - this does not open the receiver to other apps.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>